<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Apenas o APK de depuração recebe a CA local gerada por prepare.sh. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/lab_ca" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
